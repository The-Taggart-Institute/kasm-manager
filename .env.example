# Kasm Manager configuration.
# Copy to .env (or export these variables). Only KASM_DOMAIN is required;
# every other value has a working default shown here.

# Required: domain instances are served under, as https://kasm-<id>.KASM_DOMAIN
KASM_DOMAIN=lab.example.com

# Kubernetes namespace for all instance objects
KASM_NAMESPACE=kasm

# Range of logical instance IDs (no longer real ports)
KASM_ID_START=6901
KASM_ID_END=7000

# Length of the generated per-instance VNC password
KASM_PASSWORD_LEN=20

# Seconds after which `prune` destroys an instance (2 hours)
KASM_MAX_SESSION_TIME=7200

# NAME of the Kubernetes secret holding the wildcard cert — not the cert itself.
# setup.sh creates this secret (in KASM_NAMESPACE) from the certbot PEM files;
# the value here must match the name setup.sh uses. Missing secret = Traefik
# serves its default self-signed cert instead.
KASM_TLS_SECRET=kasm-wildcard-tls

# Label selector identifying managed instances
KASM_LABEL_SELECTOR=app=kasm

# Workspace images. Set any KASM_IMAGE_<KEY> to define an image type named
# <key> (lowercased); defining any replaces the two defaults.
KASM_IMAGE_TERMINAL=taggarttech/tti-kasm-terminal:latest
KASM_IMAGE_KALI=taggarttech/tti-kasm-kali:latest
