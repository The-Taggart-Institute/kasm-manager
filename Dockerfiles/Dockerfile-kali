FROM docker.io/kasmweb/core-kali-rolling:1.17.0
USER root

ENV HOME /home/kasm-default-profile
ENV STARTUPDIR /dockerstartup
ENV INST_SCRIPTS $STARTUPDIR/install

# TTI Refresh the Kali archive signing key (2025 key rotation) and install packages
RUN wget -q -O - https://archive.kali.org/archive-keyring.gpg > /usr/share/keyrings/kali-archive-keyring.gpg \
    && apt update && apt install -y zaproxy vim-gtk3 terminator fish build-essential

# TTI Copy custom yaml
COPY ./kasmvnc.yaml /etc/kasmvnc/kasmvnc.yaml
# Newer base images hardcode -sslOnly on the vncserver CLI, overriding require_ssl: false;
# strip it so the config file governs TLS (we terminate TLS at the ingress instead).
RUN sed -i 's/ -sslOnly//' /dockerstartup/vnc_startup.sh
COPY ./tti_banner.png /usr/share/backgrounds/kali-16x9/default
WORKDIR $HOME

######### Customize Container Here ###########
# TTI final touches
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
RUN $HOME/.cargo/bin/cargo install feroxbuster
RUN $HOME/.cargo/bin/cargo install rustscan
RUN ln -s $HOME/.cargo/bin/rustscan /usr/local/bin/rustscan

######### End Customizations ###########

RUN chown 1000:0 $HOME
RUN $STARTUPDIR/set_user_permission.sh $HOME

ENV HOME /home/kasm-user
WORKDIR $HOME
RUN mkdir -p $HOME && chown -R 1000:0 $HOME

USER 1000